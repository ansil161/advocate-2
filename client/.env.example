# The origin the site is deployed to, with no trailing slash.
#
# Used for two things, both of which require absolute URLs:
#   - canonical / og:url / og:image in components/shell/PageMeta.jsx
#   - <loc> entries in the sitemap generated by vite.config.js
#
# When unset, PageMeta falls back to window.location.origin (correct, but only
# resolvable by clients that run scripts) and no sitemap.xml is emitted.
VITE_SITE_URL=https://www.example.com
