# The origin the site is deployed to, with no trailing slash.
#
# Used for two things, both of which require absolute URLs:
#   - canonical / og:url / og:image in components/shell/PageMeta.jsx
#   - <loc> entries in the sitemap generated by vite.config.js
#
# When unset, PageMeta falls back to window.location.origin (correct, but only
# resolvable by clients that run scripts) and no sitemap.xml is emitted.
VITE_SITE_URL=https://www.example.com

# Origin of the AI assistant service in ai/, with no trailing slash.
#
# Read by lib/chatApi.js. Leave it empty when the service is reverse-proxied
# under the same origin as the site — the client then calls /api/chat as a
# relative path, which is the simplest production arrangement and needs no CORS
# at all. Set it only when the service is on a different origin, and add that
# same site origin to CORS_ALLOW_ORIGINS in ai/.env.
#
# NOTE: every VITE_ value is inlined into the public JavaScript bundle. Only
# ever put a URL here. The Hugging Face and Qdrant credentials live in ai/.env
# and are read by the server; they must never appear in this file.
VITE_AI_API_URL=http://127.0.0.1:8001

# Origin of the Django backend in server/, with no trailing slash.
#
# Read by admin/lib/adminApi.js, which is loaded only inside the lazy /admin
# chunk — a visitor to the public site never downloads it.
#
# This origin must also appear in the backend's DJANGO_CSRF_TRUSTED_ORIGINS (and
# DJANGO_CORS_ALLOWED_ORIGINS if set): the admin panel sends its session cookie
# cross-origin, and credentialed CORS cannot use a wildcard.
#
# IMPORTANT — use the SAME hostname the site itself is served from. To a
# browser "localhost" and "127.0.0.1" are different sites, so a SameSite=Lax
# session cookie set by one is never sent to the other. The symptom is
# specific and misleading: the login request itself is rejected as a CSRF
# failure, or it succeeds and every following request comes back
# "You do not have administrator access" — which looks like a permissions bug
# and is really a cookie that was never sent. If the dev server is on
# http://localhost:5173, this must be http://localhost:8000, not 127.0.0.1.
#
# Same note as above — this is inlined into the public JavaScript bundle, so it
# may only ever be a URL. The Django secret key and database password live in
# server/.env and are read by the server.
VITE_ADMIN_API_URL=http://127.0.0.1:8000
