# Docker Compose variables — the stack's shape, not its secrets.
#
# Copy to `.env` at the repo root. Compose reads this file automatically for
# variable substitution in docker-compose.yml.
#
# Per-service credentials live in `ai_service/.env` and `server/.env`, which
# Compose mounts via `env_file`. Keeping them separate means this file can be
# read by anyone deciding how to deploy, while the API keys stay in files that
# are gitignored and never enter an image layer.

# Required. Compose refuses to start without it rather than defaulting to
# something guessable — a database with a known password on a published port is
# the single most common way one of these stacks gets compromised.
POSTGRES_PASSWORD=change-me-before-deploying

# Optional; these are the defaults the services already assume.
POSTGRES_DB=sla_advocate
POSTGRES_USER=postgres
