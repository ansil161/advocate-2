# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Real environment files never get committed — only .env.example does, which
# documents the keys. VITE_* values are inlined into the client bundle at build
# time, and the Django settings in server/ read secrets from here too.
.env
.env.*
!.env.example

# Python bytecode from server/
__pycache__/
*.py[cod]

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
