# SLA Advocates — AI service configuration.
#
# Copy to .env and fill in. The real .env is gitignored (see the repo root
# .gitignore); only this file, with placeholders, is ever committed.
#
# Every value here is read once at startup by app/core/config.py. Nothing in
# this file reaches the browser — the client only ever learns the URL of this
# service, which it reads from the frontend's own VITE_ variable.

# ── Hugging Face Inference API ───────────────────────────────────────────────
# REQUIRED. This token is what turns text into vectors, so without it there is
# no vector search and scripts/index_knowledge.py cannot run at all — the
# assistant falls back to lexical matching over the same corpus.
# Create at https://huggingface.co/settings/tokens (a fine-grained read token
# with "Make calls to Inference Providers" is sufficient).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The embedding model. If you change this you MUST change HF_EMBEDDING_DIM to
# match and re-run scripts/index_knowledge.py --rebuild — a collection's vector
# size is fixed at creation, and vectors of the wrong width are rejected
# outright. Embeddings deliberately stay on Hugging Face even though generation
# has moved to Gemini: switching embedding vendors means re-indexing the corpus
# into a new vector space, which is not a configuration change.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_DIM=384

# Hugging Face generation, used only as the failover behind Gemini.
HF_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_CHAT_MODEL_FALLBACK=Qwen/Qwen2.5-7B-Instruct

# ── Gemini (primary generation) ──────────────────────────────────────────────
# The model that composes answers, given the retrieved reference material and
# the visitor's question. Create a key at https://aistudio.google.com/apikey
#
# Without this the service still retrieves correctly and quotes the firm's own
# text verbatim — a degraded but truthful mode, not an outage.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# Gemini 3.x reasons before answering and charges those reasoning tokens
# against the SAME ceiling as the reply, so LLM_MAX_OUTPUT_TOKENS alone is a
# budget shared between thinking and answering — and the answer is what gets
# cut when it runs out.
#
# "low" is the least reasoning both models above will accept. Do not use
# thinkingBudget=0 instead: it switches reasoning off on -flash but is rejected
# with HTTP 400 by -flash-lite, which would take the fallback model offline.
# Clear this value entirely to omit the field for a model that has no such
# setting.
GEMINI_THINKING_LEVEL=low

# Added to LLM_MAX_OUTPUT_TOKENS for Gemini only, to pay for that reasoning.
# Measured against this service's own prompt: gemini-3.5-flash spends 236–783
# reasoning tokens per answer at "low"; -flash-lite spends none. 900 clears the
# worst case with room to spare.
#
# If this is set too low the symptom is a reply that stops mid-sentence.
GEMINI_THINKING_HEADROOM_TOKENS=900

# ── Groq (failover generation) ───────────────────────────────────────────────
# Speaks the OpenAI chat-completions dialect, so pointing GROQ_API_BASE at
# OpenAI or any compatible host works with no code change.
GROQ_API_KEY=your-groq-api-key
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

# Generation backends in the order they are tried. Each vendor contributes its
# own primary-then-fallback models, so the default expands to:
#   gemini-3.5-flash → gemini-3.5-flash-lite → llama-3.3-70b → llama-3.1-8b
# An unknown name is skipped with a warning rather than failing startup.
#
# "langchain" is also accepted, and adds one provider whose internal
# Gemini→Groq fallback is assembled by LangChain's own with_fallbacks(). It is
# OFF by default because importing the LangChain stack costs 20s+ on first use
# — paid at every deploy and autoscale event — and because it adds no
# resilience the native chain lacks (it re-probes a dead vendor on every
# request, where the circuit breaker here does not). Enable it only if you want
# LangChain's ecosystem (callbacks, LangSmith tracing):
#   LLM_PROVIDER_ORDER=langchain,gemini,groq
# NOTE: langchain-core warns that its pydantic-v1 shim is unsupported on
# Python 3.14, which is this project's interpreter.
LLM_PROVIDER_ORDER=gemini,groq,huggingface

# How many consecutive failures take a provider out of rotation, and for how
# long. Without this a dead vendor is retried on every request and burns its
# full retry budget before failover begins.
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30

# ── Qdrant ───────────────────────────────────────────────────────────────────
# The cluster may host other projects' collections; this service only ever
# reads and writes QDRANT_COLLECTION and never enumerates or deletes others.
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=sla_knowledge

# ── Embeddings ───────────────────────────────────────────────────────────────
# "gemini" or "huggingface". This cannot be changed in isolation: a collection's
# vector width is fixed at creation, so switching provider or dimension needs
#   python scripts/index_knowledge.py --rebuild
# and re-calibrating RAG_SCORE_THRESHOLD below. Queries must be embedded by the
# same model that indexed the documents, or they land in a different vector
# space and every score becomes meaningless without anything visibly failing.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# ── Retrieval tuning ─────────────────────────────────────────────────────────
# RAG_SCORE_THRESHOLD is the hallucination brake: chunks scoring below it are
# discarded, and a question that retrieves nothing above it is answered with
# the "no verified information" fallback rather than sent to the model bare.
#
# IT IS SPECIFIC TO THE EMBEDDING MODEL and must be re-measured whenever that
# changes. 0.58 is calibrated for gemini-embedding-001 at 768 dims against the
# real corpus: off-topic questions peak at 0.5349, on-topic bottom out at
# 0.6439, and 0.58 sits mid-gap. The old 0.30 was a MiniLM number — under
# Gemini it let "what is the capital of Brazil" retrieve five chunks at ~0.49.
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.58
RAG_MAX_CONTEXT_CHARS=6000

# ── Hybrid retrieval ─────────────────────────────────────────────────────────
# Every question runs two retrievers — Qdrant cosine search and an in-process
# BM25 index over the same approved corpus — merged by Reciprocal Rank Fusion.
# The payoff is corroboration: on this corpus every off-topic question is found
# by the vector branch alone, while every on-topic one is found by both.
#
# RAG_CANDIDATES is fetched per branch before fusion. Wider than RAG_TOP_K
# deliberately: fusion and reranking can only reorder what retrieval handed
# them, so this is the real ceiling on what an answer can be built from.
RAG_CANDIDATES=25
# RRF damping. Lower lets one branch's first place dominate; higher weights
# agreement between branches. 60 is the value from the original RRF paper.
RAG_RRF_K=60

# "none" or "llm". The LLM reranker adds a full generation round trip to every
# knowledge question — a real latency cost, so it is opt-in rather than
# inherited. A local cross-encoder is deliberately not an option: this service
# excludes torch to stay deployable as a small, weightless container.
RAG_RERANKER=none

# ── Confidence policy ────────────────────────────────────────────────────────
# Both on the same 0..1 scale as cosine, both derived from the same measured
# distribution as RAG_SCORE_THRESHOLD (on-topic 0.6439–0.8020, off-topic peaks
# at 0.5349). HIGH requires a strong match AND independent support — either
# both retrieval branches agreeing, or two different source documents. One good
# chunk can be luck; two retrievers that fail differently agreeing is evidence.
RAG_CONFIDENCE_HIGH=0.70
RAG_SUPPORT_FLOOR=0.62

# Chunks any one source document may contribute before others get a turn, so a
# long advocate profile cannot consume the whole context budget on a question
# the Team index page would have answered. Lifted automatically when every
# candidate came from the same document, since there is then nothing to crowd out.
RAG_MAX_CHUNKS_PER_DOCUMENT=2

# ── Conversation and limits ──────────────────────────────────────────────────
CHAT_MAX_MESSAGE_CHARS=1000
CHAT_HISTORY_TURNS=6
CHAT_CONVERSATION_TTL_SECONDS=3600
LLM_MAX_OUTPUT_TOKENS=500
LLM_TIMEOUT_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=20

# ── Abuse protection ─────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200

# ── Service ──────────────────────────────────────────────────────────────────
# Comma-separated exact origins. No wildcard: this endpoint costs money per
# call, so it answers the firm's own site and nothing else.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Turn on ONLY when this service sits behind a reverse proxy that sets
# X-Forwarded-For itself. With it on and no such proxy in front, any caller can
# choose their own rate-limit bucket by sending the header.
TRUST_PROXY_HEADERS=false

LOG_LEVEL=INFO

# "production" switches logs to JSON lines and makes a missing CORS origin list
# a startup error rather than a warning.
ENVIRONMENT=development

# ── Redis ────────────────────────────────────────────────────────────────────
# Shared state for rate limiting, conversation memory and the metrics window.
#
# Optional. Unset — or set but unreachable at startup — falls back to per-process
# state and reports "shared_state": "in-process" on /api/health. The consequence
# is concrete: with N uvicorn workers the rate limit becomes N times the
# configured one, and a visitor's follow-up is only understood if it lands on the
# worker that answered the first message. Run a single worker, or set this.
#
# Under Docker Compose this is overridden to redis://redis:6379/0.
REDIS_URL=
