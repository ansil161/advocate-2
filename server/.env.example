# SLA Advocates — Django backend configuration.
#
# Copy to server/.env and fill in. The real .env is gitignored by the repo-root
# .gitignore; only this file, with placeholders, is ever committed.
#
# Read by sla/sla/settings.py at import. Real environment variables take
# precedence, so a container injecting them properly ignores this file.

# ── Core ─────────────────────────────────────────────────────────────────────
# Leave DJANGO_DEBUG=true only for local development. With it off, the settings
# module REFUSES to start without DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS and
# POSTGRES_PASSWORD — each of those failing silently is worse than not booting.
DJANGO_DEBUG=true

# Signing key for sessions and password-reset tokens. Anyone holding it can
# forge a session for any user, including the admin account that will manage
# the knowledge base — so it must never be committed.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma-separated hostnames this site answers for. Required when DEBUG is off:
# an empty list makes Django accept any Host header, which allows cache
# poisoning and password-reset links pointing at someone else's domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to send authenticated unsafe requests. Include the scheme.
# The admin SPA on a different port counts as cross-origin for CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=sla_advocate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Seconds a connection is reused. 0 opens a fresh one per request.
POSTGRES_CONN_MAX_AGE=60

# ── Transport security (production only) ─────────────────────────────────────
# These apply only when DJANGO_DEBUG is false; on localhost an https redirect
# makes the site unreachable rather than secure.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000

# Turn on ONLY behind a reverse proxy that sets X-Forwarded-Proto itself. With
# it on and no such proxy, any caller can claim https by sending the header and
# defeat both the redirect and the Secure cookie flag.
DJANGO_TRUST_PROXY_SSL_HEADER=false

# ── Email ────────────────────────────────────────────────────────────────────
# Defaults to the console backend in development and SMTP otherwise.
DJANGO_EMAIL_BACKEND=

# ── Redis, cache and Celery ──────────────────────────────────────────────────
# Optional. With REDIS_URL unset the Django cache falls back to local memory and
# bulk reindexing runs on an in-process thread pool — fine for `runserver`, but
# that background work dies with the process that started it.
#
# Separate logical databases on purpose: a cache flush must not discard queued
# jobs, and a broker backlog must not evict cached values.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Tasks wait on the embedding API, so more concurrency here means more parallel
# load on a rate-limited provider rather than more throughput.
CELERY_WORKER_CONCURRENCY=2
